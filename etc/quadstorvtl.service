[Unit]
Description=QuadStor Virtual Tape Library
After=network.target syslog.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/rc.d/init.d/quadstorvtl start
ExecStop=/etc/rc.d/init.d/quadstorvtl stop
ExecReload=/etc/rc.d/init.d/quadstorvtl restart
TimeoutStartSec=120
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
